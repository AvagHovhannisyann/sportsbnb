# Copy to .env and fill in your project values.
# These are client-exposed (VITE_) keys — still keep .env out of git.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Yandex Maps. Both keys ship in the browser bundle by necessity, so restrict
# each by HTTP referrer in the Yandex Developer Dashboard; both are billable.
#
# Maps and Geocoder are separate products with separate keys — one does not
# authorise the other. Without VITE_YANDEX_MAPS_API_KEY the app still runs:
# every map surface shows a "Map unavailable" panel and the rest of each page
# works, which is the state CI runs in.
VITE_YANDEX_MAPS_API_KEY=""
VITE_YANDEX_GEOCODER_KEY=""

# Server-side, set on the Supabase project rather than here. Listed so the
# whole set is visible in one place: it backs the `geosuggest` edge function,
# which is what the location search boxes call for suggestions.
# YANDEX_GEOSUGGEST_API_KEY
#
# VITE_GOOGLE_MAPS_BROWSER_KEY and VITE_GOOGLE_MAPS_TRACKING_ID were removed
# with the move to Yandex. Nothing reads them; delete them from any deployment
# environment that still carries them, so the Google key can be revoked.
